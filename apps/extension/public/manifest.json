{
  "manifest_version": 3,
  "name": "Navidrome Player",
  "version": "1.0.3",
  "description": "A full-page music player for Navidrome.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Player"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
