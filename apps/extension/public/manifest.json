{
  "manifest_version": 3,
  "name": "Navidrome Player",
  "version": "1.0.1",
  "description": "A full-page music player for Navidrome.",
  "action": {
    "default_title": "Open Player"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}